MONITOR_MODE=demo
# Optional override for the bundled Kamchatka municipal boundaries.
# CITIZEN_DISTRICTS_FILE=/app/runtime/citizens/districts.geojson
MONITOR_PORT=8080
POSTGRES_PASSWORD=
PUBLIC_URL=http://localhost:8080

# Set your Weather VLM URL for preview. Live requires HTTPS and OIDC.
MODEL_URL=
MODEL_CONTRACT=scene_v2
MODEL_TOKEN=
OIDC_ISSUER=
OIDC_JWKS_URL=
OIDC_AUDIENCE=
OPERATOR_SUBJECTS=
VIEWER_SUBJECTS=
# JSON object mapping contractor OIDC subjects to their exact dispatch assignee name.
DISPATCH_CREW_SUBJECTS={}

OPENWEATHER_KEY=
SNOW_PROBABILITY=0.5
# Optional snow simulation service (URL without /api/snow).
SNOW_SIM_URL=
SNOW_CITY_REMOTE_URL=
SUMMARY_HOUR=7

# Public RNIS collection defaults to on in preview. Use 0 to disable.
# Publish delay hints per section and period in the optional JSON file.
BUS_RNIS_ENABLED=
BUS_SECTIONS_FILE=

MAIL_TO=
MAIL_FROM=monitor@localhost
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=

# Optional S3 backend. Standard AWS credential environment applies.
S3_BUCKET=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional Telegram polling. bootstrap.sh fills in the internal key.
BOT_TOKEN=
MAX_BOT_TOKEN=
CITIZEN_BOT_API_KEY=

# JSON maps messenger IDs to assignee names in the dispatcher.
DISPATCH_BOT_CREWS={}
# Comma-separated Telegram administration and MAX dispatcher account IDs.
DISPATCH_TELEGRAM_ADMINS=
DISPATCH_MAX_OPERATORS=

# Base URL of the read-only traffic feed, reached through the Windows SSH tunnel.
TRAFFIC_WORKER_URL=

# Freshness thresholds (seconds).
TRAFFIC_TTL_SECONDS=3600
WEATHER_TTL_SECONDS=3600
WORKER_HEARTBEAT_TTL_SECONDS=90
