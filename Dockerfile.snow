FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/opt/simulator
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt numpy==2.2.6 shapely==2.1.2
COPY --from=simsource snowmap/ /opt/simulator/snowmap/
COPY --from=simsource kernels/ /opt/simulator/kernels/
COPY --from=simsource data/petropavlovsk-buildings.json /opt/simulator/data/petropavlovsk-buildings.json
COPY monitoring/ ./monitoring/
USER 10001:10001
CMD ["uvicorn", "monitoring.city_solver:app", "--host", "0.0.0.0", "--port", "8090"]
