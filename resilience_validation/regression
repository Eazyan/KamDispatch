#!/bin/sh
set -eu
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"
database="validation_regression_$(date +%s)_$$"
validation=resilience_validation/compose
docker build -t kamdispatch-hardening-tests:test -f resilience_validation/Dockerfile.tests resilience_validation
"$validation" exec -T db createdb -U monitor "$database"
trap '"$validation" exec -T db dropdb -U monitor "$database"' EXIT
docker run --rm --network kamdispatch-hardening_backend --env-file .resilience-validation/local.env \
  -e "TEST_DB=$database" --mount "type=bind,src=$root,dst=/suite,readonly" -w /suite kamdispatch-hardening-tests:test \
  sh -c 'TEST_DATABASE_URL="host=db port=5432 dbname=$TEST_DB user=monitor password=$POSTGRES_PASSWORD" python -m pytest -p no:cacheprovider -q'
