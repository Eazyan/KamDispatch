{
  "$schema": "https://opencode.ai/config.json",
  "model": "local/security",
  "providers": {
    "local": {
      "name": "Local Qwen",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8081/v1"
      },
      "models": {
        "security": {
          "modelID": "local-security",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    }
  }
}
